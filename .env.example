# Copy to .env for running the API outside Docker: cp .env.example .env
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://monetka:monetka@localhost:5432/monetka
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# Must be changed in production; the app refuses to start there with these defaults
JWT_SECRET=local-dev-jwt-secret-change-me-in-production
PSP_SECRET=local-dev-psp-secret-change-me-in-production
